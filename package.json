
{
  "name": "atelier-tests",
  "version": "1.0.0",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:int": "jest tests/integration --runInBand",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
